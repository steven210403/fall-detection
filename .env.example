# Copy to backend/.env for local development. Never commit real credentials.
FALL_ENVIRONMENT=development
# cpu | cuda (NVIDIA) | mps (Apple) | intel:gpu (Intel Iris/Arc, OpenVINO) | intel:cpu
FALL_DEVICE=cpu
FALL_DATABASE_URL=sqlite+pysqlite:///./data/fall_detection.db
FALL_LOG_LEVEL=INFO

# --- Video ingestion ---------------------------------------------------------
# mode: "mp4" reads a file, "rtsp" reads a live camera (see `make camera`), and
# "webcam" reads a local camera directly.
FALL_VIDEO__MODE=mp4
# For mp4 mode: a path that resolves INSIDE one of the authorized media roots.
FALL_VIDEO__SOURCE_REF=
# Authorized directories for local video, separated by ":" on macOS/Linux and by
# ";" on Windows (e.g. C:\videos;D:\datasets). Empty means no local path may be
# opened at all; the allow-list fails closed on purpose.
FALL_MEDIA_ROOTS__ROOTS=
# For webcam mode. macOS: an index (0) or name. Linux: an index (0 = /dev/video0)
# or a /dev path. Windows: the DirectShow camera NAME, never an index
# (`scripts\dev.ps1 devices` lists them).
# FALL_VIDEO__WEBCAM_DEVICE=0
FALL_VIDEO__READ_TIMEOUT_S=15
# Required when FALL_VIDEO__MODE=rtsp. Never commit a real credential.
# FALL_RTSP_URL=rtsp://user:password@camera.example/stream1

# --- Pose detector (YOLOv8n-pose is the thesis's primary model) ----------------
# Comparison models: models/yolo11n-pose.pt, models/yolo26n-pose.pt
FALL_DETECTION__ENABLED=true
FALL_DETECTION__MODEL_PATH=models/yolov8n-pose.pt
FALL_DETECTION__IMGSZ=640
FALL_DETECTION__CONF=0.25
FALL_DETECTION__CLASSES=person

# --- Tracking ----------------------------------------------------------------
FALL_TRACKING__ENABLED=true
FALL_TRACKING__TRACKER=bytetrack
# A person lying still after a fall can drop out of detection briefly; a longer
# tolerance keeps their identity (and their fall state) across short gaps.
FALL_TRACKING__LOSS_TOLERANCE_S=3.0
FALL_TRACKING__STALE_AFTER_S=0.5
FALL_TRACKING__ASSUMED_UPDATE_RATE_HZ=15.0

# --- Fall detection (literature defaults; see THESIS_PLAN.md §5) ---------------
FALL_FALL__ENABLED=true
FALL_FALL__KEYPOINT_MIN_CONF=0.3
FALL_FALL__AR_THRESHOLD=1.0
FALL_FALL__ANGLE_LYING_DEG=30
FALL_FALL__ANGLE_UPRIGHT_DEG=45
FALL_FALL__VY_THRESHOLD=1.0
FALL_FALL__IMPACT_WINDOW_S=1.0
FALL_FALL__LONG_LIE_S=3.0
FALL_FALL__REQUIRE_BOTH=false
FALL_FALL__RECOVERY_HOLD_S=0.5
# After calibration, point this at the frozen thresholds instead:
# FALL_FALL__CALIBRATION_PATH=datasets/manifests/fall_calibration.json

# --- Live preview ------------------------------------------------------------
FALL_STREAMING__ENABLED=true
FALL_STREAMING__PREVIEW_FPS=10.0
FALL_STREAMING__PREVIEW_MAX_WIDTH=960
FALL_STREAMING__PREVIEW_MAX_HEIGHT=540
FALL_STREAMING__JPEG_QUALITY=80
FALL_STREAMING__CLIENT_QUEUE_CAPACITY=2
FALL_STREAMING__SNAPSHOT_INTERVAL_S=0.5
FALL_STREAMING__MAX_CLIENTS=8
